# WhatsApp Panel — Variables de entorno
# Copiar como .env en cada carpeta (backend/ y frontend/)

# ── Base de datos ──────────────────────────────────────────
DATABASE_URL="postgresql://whatsapp:whatsapp_secret@localhost:5432/whatsapp_panel"

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET="tu-secreto-super-seguro-cambialo-en-produccion"
JWT_EXPIRES_IN="7d"

# ── Servidor ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── WhatsApp Cloud API ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=whatsapp-panel-verify

# ── IA (configurable desde el panel) ──────────────────────
# Estas son las defaults, se pueden agregar mas desde Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Storage ────────────────────────────────────────────────
MEDIA_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── n8n (opcional) ────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_API_KEY=
