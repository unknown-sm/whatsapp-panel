// WhatsApp Panel — Prisma Schema
// Base de datos PostgreSQL para plataforma de automatizacion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// AUTENTICACION Y USUARIOS
// ═══════════════════════════════════════════════════════════

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(AGENT)
  name      String?
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedConversations Conversation[]
  notes                 ContactNote[]
  assignedDeals         Deal[]
}

// ═══════════════════════════════════════════════════════════
// CONFIGURACION DE WHATSAPP
// ═══════════════════════════════════════════════════════════

model WhatsappConfig {
  id            String   @id @default(uuid())
  phoneNumberId String
  accessToken   String
  verifyToken   String
  status        String   @default("offline")
  lastPing      DateTime?
  webhookUrl    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  key     String   @id
  value   String
  updatedAt DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// BOTS Y FLOW
// ═══════════════════════════════════════════════════════════

model Bot {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String?
  exactMatch   Boolean  @default(false)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  keywords     BotKeyword[]
  flowSteps    FlowStep[]
  followUpRules FollowUpRule[]
  conversations Conversation[]
  knowledge    BotKnowledge[]
}

model BotKnowledge {
  id        String   @id @default(uuid())
  botId     String
  filename  String
  mimeType  String
  content   String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
}

model CrmLog {
  id        String   @id @default(uuid())
  level     String   @default("info")
  source    String
  action    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([source])
}

model BotKeyword {
  id      String @id @default(uuid())
  keyword String
  botId   String
  bot     Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([keyword])
}

model FlowStep {
  id              String   @id @default(uuid())
  botId           String
  order           Int
  stepType        StepType
  message         String?
  waitSeconds     Int      @default(0)
  responseType    ResponseType?
  responseCapture String?
  config          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot             Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  media           FlowStepMedia?
  intentRoutes    IntentRoute[]
  httpRoutes      HttpRoute?

  // Secuencia de pasos
  nextStepId      String?
  nextStep        FlowStep?  @relation("StepSequence", fields: [nextStepId], references: [id])
  previousSteps   FlowStep[] @relation("StepSequence")

  // Rutas de fallback y exito para bloques condicionales
  onSuccessStepId String?
  onSuccessStep   FlowStep?  @relation("OnSuccessStep", fields: [onSuccessStepId], references: [id])
  onFailureStepId String?
  onFailureStep   FlowStep?  @relation("OnFailureStep", fields: [onFailureStepId], references: [id])
  successFromSteps FlowStep[] @relation("OnSuccessStep")
  failureFromSteps FlowStep[] @relation("OnFailureStep")
  intentFromSteps IntentRoute[] @relation("IntentNextStep")

  @@index([botId])
  @@index([order])
}

model FlowStepMedia {
  id       String   @id @default(uuid())
  stepId   String   @unique
  fileType String
  fileName String
  filePath String
  fileSize Int
  mimeType String?

  step     FlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model IntentRoute {
  id         String   @id @default(uuid())
  stepId     String
  label      String
  samples    String[]
  nextStepId String?

  step       FlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  nextStep   FlowStep? @relation("IntentNextStep", fields: [nextStepId], references: [id])

  @@index([stepId])
}

model HttpRoute {
  id          String   @id @default(uuid())
  stepId      String   @unique
  method      String   @default("GET")
  url         String
  headers     Json?
  body        Json?
  variableMap Json?
  timeout     Int      @default(10000)

  step        FlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// CONFIGURACION DE IA
// ═══════════════════════════════════════════════════════════

model AIConfig {
  id        String   @id @default(uuid())
  name      String
  provider  String
  apiKey    String
  model     String
  endpoint  String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// CRM — CONTACTOS
// ═══════════════════════════════════════════════════════════

model Contact {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  firstContact DateTime @default(now())
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags         ContactTags[]
  conversations Conversation[]
  notes        ContactNote[]
  leadScores   LeadScore[]
  deals        Deal[]
  broadcastRecipients BroadcastRecipient[]
  customFieldValues   CustomFieldValue[]
  conversationWindow  ConversationWindow?
  adAttributions      AdAttribution[]
  abTestAssignments   PlaybookABTestAssignment[]
}

model ContactTags {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  color    String    @default("#3B82F6")
  contacts ContactTags[]
}

model ContactNote {
  id        String   @id @default(uuid())
  contactId String
  content   String
  agentId   String?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent   User?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([contactId])
}

// ═══════════════════════════════════════════════════════════
// CONVERSACIONES Y MENSAJES
// ═══════════════════════════════════════════════════════════

model Conversation {
  id              String   @id @default(uuid())
  contactId       String
  botId           String?
  status          String   @default("active")
  currentStepId   String?
  silencedUntil   DateTime?
  assignedAgentId String?
  contextVars     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contact         Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  bot             Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  assignedAgent   User?      @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages        Message[]
  followUpAttempts FollowUpAttempt[]

  @@index([contactId])
  @@index([botId])
  @@index([status])
  @@index([assignedAgentId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  direction      String
  type           String   @default("text") // text, image, audio, video, document, voice, sticker, location
  content        String
  mediaUrl       String?  // URL original de Meta
  mediaLocalPath String?  // Path local en uploads/
  mediaMimeType  String?  // image/jpeg, audio/ogg, etc
  mediaFilename  String?
  mediaSize      Int?
  transcription  String?  // Audio transcrito por IA
  variables      Json?
  timestamp      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
}

// ═══════════════════════════════════════════════════════════
// SEGUIMIENTO (FOLLOW-UP)
// ═══════════════════════════════════════════════════════════

model FollowUpRule {
  id          String   @id @default(uuid())
  botId       String
  stepId      String?
  delayHours  Int
  maxAttempts Int      @default(3)
  message     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model FollowUpAttempt {
  id             String   @id @default(uuid())
  conversationId String
  ruleId         String
  attemptNumber  Int
  sentAt         DateTime @default(now())
  replied        Boolean  @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([replied])
}

// ═══════════════════════════════════════════════════════════
// CONFIGURACION DE OPENWA
// ═══════════════════════════════════════════════════════════

model OpenwaConfig {
  id         String   @id @default(uuid())
  baseUrl    String   @default("http://openwa:2785")
  apiKey     String   @default("")
  sessionId  String   @default("")
  status     String   @default("disconnected")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum Role {
  ADMIN
  AGENT
}

enum StepType {
  TEXT
  AI_AGENT
  HTTP_REQUEST
  INTENT
  SILENCE
  CALENDAR
  VOICE_AI
  STRUCTURED_OUTPUT
  FORWARD
}

enum ResponseType {
  FREE_TEXT
  BUTTONS
  YES_NO
  NONE
}

// ═══════════════════════════════════════════════════════════
// CRM — PIPELINE Y VENTAS
// ═══════════════════════════════════════════════════════════

model Pipeline {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id         String   @id @default(uuid())
  name       String
  pipelineId String
  order      Int      @default(0)
  color      String   @default("#3B82F6")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
  @@index([order])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

model Deal {
  id                String       @id @default(uuid())
  name              String
  value             Float        @default(0)
  currency          String       @default("USD")
  contactId         String?
  stageId           String
  pipelineId        String
  status            DealStatus   @default(OPEN)
  priority          DealPriority @default(MEDIUM)
  assignedToId      String?
  expectedCloseDate DateTime?
  source            String?
  tags              String[]     @default([])
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([pipelineId])
  @@index([assignedToId])
  @@index([contactId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// LEAD SCORING
// ═══════════════════════════════════════════════════════════

enum ScoreCondition {
  MESSAGE_RECEIVED
  MESSAGE_SENT
  KEYWORD_MATCHED
  TAG_ADDED
  CONVERSATION_CLOSED
  FOLLOW_UP_REPLIED
  DEAL_CREATED
  DEAL_WON
}

model LeadScoreRule {
  id          String        @id @default(uuid())
  name        String
  condition   ScoreCondition
  config      Json?         // { keyword: "comprar", tagId: "...", minMessages: 3 }
  points      Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  scores      LeadScore[]
}

model LeadScore {
  id        String   @id @default(uuid())
  contactId String
  ruleId    String
  points    Int
  reason    String   // descripción legible del evento
  createdAt DateTime @default(now())

  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rule      LeadScoreRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([ruleId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// BROADCAST / CAMPAIGNS
// ═══════════════════════════════════════════════════════════

model BroadcastTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  variables String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broadcasts Broadcast[]
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Broadcast {
  id          String          @id @default(uuid())
  name        String
  templateId  String?
  content     String
  status      BroadcastStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  totalCount  Int             @default(0)
  sentCount   Int             @default(0)
  failedCount Int             @default(0)
  filters     Json?           // { tags: ["vip"], minScore: 50 }
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  template    BroadcastTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients  BroadcastRecipient[]
}

model BroadcastRecipient {
  id          String   @id @default(uuid())
  broadcastId String
  contactId   String
  status      String   @default("pending") // pending, sent, failed
  sentAt      DateTime?
  error       String?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([contactId])
}

// ═══════════════════════════════════════════════════════════
// CUSTOM FIELDS
// ═══════════════════════════════════════════════════════════

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum EntityType {
  CONTACT
  DEAL
}

model CustomField {
  id          String   @id @default(uuid())
  name        String
  fieldType   FieldType
  entityType  EntityType
  options     String[] @default([]) // For SELECT type
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values CustomFieldValue[]
}

model CustomFieldValue {
  id            String @id @default(uuid())
  customFieldId String
  contactId     String?
  dealId        String?
  value         String

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([customFieldId])
  @@index([contactId])
  @@index([dealId])
}

// ═══════════════════════════════════════════════════════════
// SESSION MANAGER — 24h Window Tracking (Meta API compliance)
// ═══════════════════════════════════════════════════════════

model ConversationWindow {
  id              String    @id @default(uuid())
  contactId       String    @unique
  lastInboundAt   DateTime
  windowExpiresAt DateTime
  isOpen          Boolean   @default(true)
  lastCategory    String?   // "service", "marketing", "utility"
  totalCost       Float     @default(0)
  messageCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId])
  @@index([windowExpiresAt])
}

// ═══════════════════════════════════════════════════════════
// AD ATTRIBUTION — CTWA Tracking
// ═══════════════════════════════════════════════════════════

model AdAttribution {
  id              String    @id @default(uuid())
  contactId       String
  adId            String?
  campaignId      String?
  adSetId         String?
  creativeId      String?
  source          String    @default("whatsapp") // "facebook", "instagram", "google", "whatsapp"
  medium          String    @default("paid_social") // "paid_social", "organic", "referral"
  campaign        String?
  adSetName       String?
  adName          String?
  refParameter    String?
  utmSource       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  firstMessageAt  DateTime  @default(now())
  conversionAt    DateTime?
  conversionValue Float?
  createdAt       DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId])
  @@index([campaignId])
  @@index([source])
}

// ═══════════════════════════════════════════════════════════
// SALES PLAYBOOKS — Metodologias de venta
// ═══════════════════════════════════════════════════════════

model SalesPlaybook {
  id          String   @id @default(uuid())
  name        String
  description String?
  methodology String   // "SPIN", "BANT", "AIDA", "CHALLENGER", "CONSULTATIVE"
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages  PlaybookStage[]
  abTests PlaybookABTest[] @relation("PlaybookA")
  abTestsB PlaybookABTest[] @relation("PlaybookB")
}

model PlaybookStage {
  id             String @id @default(uuid())
  playbookId     String
  order          Int
  name           String
  prompt         String // El script que el bot/agente sigue
  questionType   String @default("open") // "open", "multiple_choice", "scale"
  options        String[] @default([])
  nextStageLogic Json?  // Condiciones para avanzar
  exitConditions Json?  // Condiciones para salir

  playbook SalesPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  @@index([playbookId])
}

model PlaybookABTest {
  id           String   @id @default(uuid())
  playbookAId  String
  playbookBId  String
  trafficSplit Int      @default(50) // % para A
  status       String   @default("draft") // "draft", "running", "completed", "paused"
  metric       String   @default("conversion_rate")
  resultsA     Json?
  resultsB     Json?
  winnerId     String?
  confidence   Float?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())

  playbookA SalesPlaybook @relation("PlaybookA", fields: [playbookAId], references: [id])
  playbookB SalesPlaybook @relation("PlaybookB", fields: [playbookBId], references: [id])
  assignments PlaybookABTestAssignment[]
  @@index([status])
}

model PlaybookABTestAssignment {
  id              String   @id @default(uuid())
  testId          String
  contactId       String
  variant         String   // "A" o "B"
  converted       Boolean  @default(false)
  conversionValue Float?
  assignedAt      DateTime @default(now())

  test    PlaybookABTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([testId])
  @@index([contactId])
}

// ═══════════════════════════════════════════════════════════
// MESSAGE TEMPLATES — Meta WhatsApp Templates
// ═══════════════════════════════════════════════════════════

model MessageTemplate {
  id                String   @id @default(uuid())
  name              String   @unique
  category          String   // "MARKETING", "UTILITY", "AUTHENTICATION"
  language          String   @default("es")
  status            String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "PAUSED", "DISABLED"
  headerType        String?  // "TEXT", "IMAGE", "VIDEO", "DOCUMENT"
  headerText        String?
  bodyText          String
  footerText        String?
  buttons           Json?
  variables         Json?
  metaTemplateId    String?
  qualityRating     String?
  lastQualityUpdate DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// SMART ROUTING — Asignacion inteligente de agentes
// ═══════════════════════════════════════════════════════════

model RoutingRule {
  id            String   @id @default(uuid())
  name          String
  priority      Int      @default(0)
  condition     Json     // { minScore?: number, tags?: string[], source?: string }
  targetAgentId String?
  targetTeam    String?  // "ventas", "soporte", "cobranza"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([priority])
}

// ═══════════════════════════════════════════════════════════
// LABORATORY — Red-team de IA con personas simuladas
// ═══════════════════════════════════════════════════════════

model AgentTestRun {
  id          String    @id @default(uuid())
  status      String    @default("running") // "running", "completed", "failed"
  score       Int?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  configId    String?
  createdById String?

  cases AgentTestCase[]

  @@index([status])
  @@index([startedAt])
}

model AgentTestCase {
  id          String   @id @default(uuid())
  runId       String
  personaId   String
  personaName String
  veredicto   String?  // "verde", "amarillo", "rojo"
  score       Int?
  hallazgos    Json?    // [{ tipo, descripcion, gravedad }]
  transcript  Json?    // [{ role, content }]
  createdAt   DateTime @default(now())

  run AgentTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
