model Conversation {
  id              String   @id @default(uuid())
  orgId           String?
  contactId       String
  botId           String?
  status          String   @default("active")
  currentStepId   String?
  silencedUntil   DateTime?
  assignedAgentId String?
  /// true = un humano tomó la conversación: el bot no responde aunque tenga botId
  humanTakeover   Boolean  @default(false)
  contextVars     Json?
  /// Próximo vencimiento de follow-up materializado: el cron solo consulta vencidos, no escanea
  nextFollowUpDueAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org             Organization? @relation("OrgConversations", fields: [orgId], references: [id], onDelete: Cascade)
  contact         Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  bot             Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  assignedAgent   User?      @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages        Message[]
  followUpAttempts FollowUpAttempt[]
  agentMessages   AgentMessage[]

  @@index([orgId])
  @@index([contactId])
  @@index([botId])
  @@index([status])
  @@index([assignedAgentId])
  @@index([nextFollowUpDueAt])
}
