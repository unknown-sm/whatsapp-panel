model Message {
  id             String   @id @default(uuid())
  conversationId String
  /// ID del mensaje en Meta (wamid.*) — dedup de webhooks reintentados
  externalId     String?
  direction      String
  type           String   @default("text") // text, image, audio, video, document, voice, sticker, location
  content        String
  mediaUrl       String?  // URL original de Meta
  mediaLocalPath String?  // Path local en uploads/
  mediaMimeType  String?  // image/jpeg, audio/ogg, etc
  mediaFilename  String?
  mediaSize      Int?
  transcription  String?  // Audio transcrito por IA
  variables      Json?
  timestamp      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
  @@index([externalId])
}
